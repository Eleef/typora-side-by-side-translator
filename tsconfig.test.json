{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": ".test-dist",
    "rootDir": ".",
    "noEmit": false
  },
  "include": [
    "tests/**/*.ts",
    "src/types.ts",
    "src/shims-markdown-it.d.ts",
    "src/utils.ts",
