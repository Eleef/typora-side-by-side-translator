{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": ".test-dist",
    "rootDir": ".",
    "noEmit": false
  },
  "include": [
    "tests/**/*.ts",
    "src/types.ts",
    "src/utils.ts",
    "src/cache/**/*.ts",
    "src/markdown/**/*.ts",
    "src/security/**/*.ts",
    "src/translation/**/*.ts"
  ]
}
